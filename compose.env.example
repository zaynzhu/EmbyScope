# 镜像离线包会自动填入本次构建标签；源码中的值必须替换。
EMBYSCOPE_IMAGE=embyscope:replace-with-commit
APP_PORT=3000
BIND_ADDRESS=0.0.0.0
# 修改为 NAS Docker 页面可访问的实际配置目录，不要填写真实凭据。
DATA_PATH=/absolute/path/to/embyscope/config
PUID=1000
PGID=1000
CACHE_MINUTES=60
REQUEST_INTERVAL_MS=2000
REQUEST_TIMEOUT_MS=12000
REQUEST_RETRIES=1
# 仅在通过 HTTPS 访问映览时设为 true。
COOKIE_SECURE=false
# 仅使用 compose.external-network.yaml 覆盖文件时填写。
EXISTING_NETWORK=your-existing-bridge
